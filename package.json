{
  "name": "neurobricks-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "sidecar:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/sidecars/nb-trainer/build-sidecar.ps1",
    "sidecar:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/sidecars/nb-trainer/build-sidecar.ps1 -VerifyOnly",
    "package:windows": "npm run sidecar:build:windows && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-portable.ps1",
    "package:windows:app-only": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-portable.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:python": "python -B -m unittest discover -s src-tauri/sidecars/nb-trainer/tests -p \"test_*.py\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run test:run && npm run test:rust && npm run test:python && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.0",
    "@tauri-apps/api": "^1.6.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.161.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.161.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "happy-dom": "^20.11.6",
    "postcss": "^8.4.35",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vitest": "^1.2.0"
  }
}
