{
  "build": {
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run sidecar:verify"
  },
  "package": {
    "productName": "NeuroBricks 3D",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true,
        "save": true
      },
      "fs": {
        "writeFile": true,
        "scope": []
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "startDragging": true
      }

    },
    "bundle": {
      "active": false,
      "targets": ["msi", "nsis"],
      "identifier": "com.neurobricks3d.app",
      "resources": [
        "sidecars/nb-trainer/main.py",
        "sidecars/nb-trainer/models.py",
        "sidecars/nb-trainer/train.py",
        "sidecars/nb-trainer/predict.py",
        "sidecars/nb-trainer/protocol.py",
        "sidecars/nb-trainer/requirements.txt",
        "sidecars/nb-trainer/data"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://raw.githubusercontent.com/nanliuqi/neurobricks-3d/main/updates/latest.json"
      ],
      "pubkey": "",
      "dialog": false
    },
    "windows": [
      {
        "title": "NeuroBricks 3D",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true
      },
      {
        "label": "chart-view",
        "title": "训练曲线",
        "url": "chart.html",
        "width": 960,
        "height": 620,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "visible": false
      }
    ]
  }
}
